# Database — local dev or Neon/Supabase for prod
# Local:     postgresql://user:password@localhost:5432/movies_db
# Neon:      postgresql://user:password@ep-xxx.neon.tech/movies_db?sslmode=require
# Supabase:  postgresql://postgres:[password]@db.[ref].supabase.co:5432/postgres
DATABASE_URL="postgresql://user:password@localhost:5432/movies_db"

# Better Auth — generate with: openssl rand -base64 32
BETTER_AUTH_SECRET=""

# App URL (no trailing slash)
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# TMDB API key — server-side only (never use NEXT_PUBLIC_ prefix)
# Get from: https://developer.themoviedb.org/
TMDB_API_KEY=""

# Note encryption key — generate with: openssl rand -hex 32
NOTE_ENCRYPTION_KEY=""

# Sentry error monitoring (optional but recommended for production)
# Server-side only (keep secret):
SENTRY_DSN=""
# Client-side (safe to expose — Sentry DSNs are public by design):
NEXT_PUBLIC_SENTRY_DSN=""

# Gmail SMTP — sends the forgot-password email
# 1. Enable 2-Step Verification on your Google account
# 2. Create an App Password: https://myaccount.google.com/apppasswords
GMAIL_USER=""
GMAIL_APP_PASSWORD=""
